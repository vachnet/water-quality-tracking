---
import Base from '../layouts/Base.astro';
import { REPORT_TYPES } from '../lib/types';
import { PROVINCES } from '../lib/provinces';
import { url } from '../lib/url';
---
<Base
  title="แจ้งเหตุน้ำเสีย ปลาตาย น้ำเปลี่ยนสี"
  description="แจ้งเหตุคุณภาพน้ำผิดปกติได้ทันทีโดยไม่ต้องสมัครสมาชิก ใช้เวลาไม่ถึงหนึ่งนาที ระบุประเภทเหตุการณ์ ตำแหน่ง และเวลา"
  path="/report/"
>
  <div class="wrap section">
    <div class="prose">
      <h1>แจ้งเหตุคุณภาพน้ำผิดปกติ</h1>
      <p class="muted">ไม่ต้องสมัครสมาชิก ใช้เวลาไม่ถึงหนึ่งนาที กรอกเพียง 3 อย่าง: ประเภทเหตุการณ์ ตำแหน่ง และเวลา</p>
    </div>

    <form id="report-form" class="card" novalidate>
      <fieldset class="field" style="border:0;padding:0;margin:0 0 18px">
        <legend>1. เกิดอะไรขึ้น <span aria-hidden="true">*</span></legend>
        <div class="types">
          {REPORT_TYPES.map((t) => (
            <label class="type">
              <input type="radio" name="type" value={t.id} required />
              <span><span class="ico" aria-hidden="true">{t.icon}</span>{t.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field">
        <label for="loc-btn">2. ตำแหน่งที่พบ <span aria-hidden="true">*</span></label>
        <div class="loc-actions">
          <button type="button" class="btn secondary" id="loc-btn">📍 ใช้ตำแหน่งปัจจุบัน (GPS)</button>
          <button type="button" class="btn secondary" id="pick-btn">🗺️ เลือกบนแผนที่</button>
        </div>
        <div id="pick-map" class="pick-map" hidden></div>
        <p class="hint" id="loc-status" aria-live="polite">ยังไม่ได้ระบุตำแหน่ง</p>
        <input type="hidden" name="lat" />
        <input type="hidden" name="lng" />
      </div>

      <div class="field">
        <label for="province">จังหวัด</label>
        <select id="province" name="province" required>
          <option value="">— เลือกจังหวัด —</option>
          {PROVINCES.map((p) => <option value={p.slug}>{p.name}</option>)}
        </select>
        <span class="hint">ระบบเดาจากตำแหน่งให้อัตโนมัติ แก้ไขได้</span>
      </div>

      <div class="field">
        <label for="occurredAt">3. เวลาที่พบ <span aria-hidden="true">*</span></label>
        <input id="occurredAt" name="occurredAt" type="datetime-local" required />
        <span class="hint">ค่าเริ่มต้นคือเวลาปัจจุบัน</span>
      </div>

      <div class="field">
        <label for="description">รายละเอียดเพิ่มเติม (ไม่บังคับ)</label>
        <textarea id="description" name="description" maxlength="300" placeholder="เช่น กลิ่น สี จำนวนปลา ชื่อคลอง/แม่น้ำใกล้เคียง"></textarea>
        <span class="hint">อย่าใส่ชื่อ เบอร์โทร หรือข้อมูลส่วนตัวของบุคคลใด</span>
      </div>

      <!-- honeypot: humans never see this -->
      <div class="hp" aria-hidden="true"><label>เว็บไซต์ <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

      <div id="turnstile" class="field"></div>

      <p class="notice" style="margin-bottom:16px">
        รายงานจะแสดงบนแผนที่ทันทีในสถานะ <strong>"ยังไม่ยืนยัน"</strong> เพื่อป้องกันการก่อกวน ระบบเก็บที่อยู่ IP ของคุณไว้ฝั่งเซิร์ฟเวอร์ชั่วคราวและไม่เปิดเผยต่อสาธารณะ
        <a href={url('/privacy/')}>อ่านรายละเอียด</a>
      </p>

      <div id="form-msg" role="alert" aria-live="assertive"></div>
      <button class="btn" type="submit" id="submit-btn">ส่งรายงาน</button>
    </form>

    <div id="success" class="card" hidden>
      <h2>✅ ส่งรายงานเรียบร้อย</h2>
      <p>ขอบคุณที่ช่วยเฝ้าระวังแหล่งน้ำ รายงานของคุณจะปรากฏบนแผนที่ในการอัปเดตรอบถัดไป (ภายในประมาณ 1 ชั่วโมง)</p>
      <p id="demo-note" class="notice" hidden>โหมดทดลอง: ยังไม่ได้เชื่อมต่อ API จริง ข้อมูลไม่ได้ถูกส่งไปที่ใด</p>
      <p><a class="btn" href={url('/')}>กลับไปดูแผนที่</a> <a class="btn secondary" href={url('/report/')}>แจ้งเหตุอีกรายการ</a></p>
    </div>
  </div>
</Base>

<script>
  import { nearestProvince } from '../lib/provinces';
  import { createMap, type PickableMap } from '../lib/map';

  const API = import.meta.env.PUBLIC_REPORT_API_URL as string | undefined;
  const TS_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

  const form = document.getElementById('report-form') as HTMLFormElement;
  const status = document.getElementById('loc-status')!;
  const msg = document.getElementById('form-msg')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const provinceSel = document.getElementById('province') as HTMLSelectElement;
  const when = document.getElementById('occurredAt') as HTMLInputElement;
  const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  // default time = now (local), cannot be in the future
  const localNow = () => {
    const d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    return d.toISOString().slice(0, 16);
  };
  when.value = localNow();
  when.max = localNow();

  function setLocation(lat: number, lng: number, label: string) {
    f('lat').value = lat.toFixed(5);
    f('lng').value = lng.toFixed(5);
    if (!provinceSel.value || provinceSel.dataset.auto === '1') {
      provinceSel.value = nearestProvince(lat, lng).slug;
      provinceSel.dataset.auto = '1';
    }
    status.textContent = `${label}: ${lat.toFixed(4)}, ${lng.toFixed(4)}`;
  }
  provinceSel.addEventListener('change', () => (provinceSel.dataset.auto = '0'));

  document.getElementById('loc-btn')!.addEventListener('click', () => {
    if (!navigator.geolocation) {
      status.textContent = 'อุปกรณ์นี้ไม่รองรับ GPS กรุณาเลือกบนแผนที่';
      return;
    }
    status.textContent = 'กำลังค้นหาตำแหน่ง…';
    navigator.geolocation.getCurrentPosition(
      (p) => {
        setLocation(p.coords.latitude, p.coords.longitude, 'ตำแหน่งปัจจุบัน');
        pickMap?.pick?.(p.coords.longitude, p.coords.latitude);
        pickMap?.flyTo({ center: [p.coords.longitude, p.coords.latitude], zoom: 14 });
      },
      () => (status.textContent = 'ไม่สามารถอ่านตำแหน่งได้ กรุณาอนุญาตการเข้าถึงตำแหน่ง หรือเลือกบนแผนที่'),
      { enableHighAccuracy: true, timeout: 12000 },
    );
  });

  let pickMap: PickableMap | undefined;
  document.getElementById('pick-btn')!.addEventListener('click', async () => {
    const el = document.getElementById('pick-map')!;
    el.hidden = false;
    if (pickMap) return;
    pickMap = (await createMap(el, { onPick: (lng, lat) => setLocation(lat, lng, 'ตำแหน่งที่เลือก') })) as PickableMap;
  });

  // Turnstile (optional until a site key is configured)
  let tsToken = '';
  if (TS_KEY) {
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    s.async = true;
    s.onload = () =>
      (window as any).turnstile.render('#turnstile', {
        sitekey: TS_KEY,
        language: 'th',
        callback: (t: string) => (tsToken = t),
        'expired-callback': () => (tsToken = ''),
      });
    document.head.append(s);
  }

  const showError = (t: string) => {
    msg.innerHTML = '';
    const p = document.createElement('p');
    p.className = 'notice err';
    p.textContent = t;
    msg.append(p);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.innerHTML = '';
    const type = (form.querySelector('input[name=type]:checked') as HTMLInputElement | null)?.value;
    if (!type) return showError('กรุณาเลือกประเภทเหตุการณ์');
    if (!f('lat').value) return showError('กรุณาระบุตำแหน่ง (ใช้ GPS หรือเลือกบนแผนที่)');
    if (!provinceSel.value) return showError('กรุณาเลือกจังหวัด');
    const at = new Date(when.value);
    if (isNaN(+at) || +at > Date.now() + 60000) return showError('เวลาที่พบไม่ถูกต้อง');
    if (TS_KEY && !tsToken) return showError('กรุณายืนยันว่าคุณไม่ใช่บอท');

    const body = {
      type,
      lat: Number(f('lat').value),
      lng: Number(f('lng').value),
      province: provinceSel.value,
      occurredAt: at.toISOString(),
      description: (f('description').value || '').trim() || undefined,
      website: f('website').value, // honeypot
      turnstileToken: tsToken || undefined,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'กำลังส่ง…';
    try {
      if (API) {
        const res = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.status === 429) throw new Error('ส่งรายงานถี่เกินไป กรุณารอสักครู่แล้วลองใหม่');
        if (res.status === 403) throw new Error('ไม่สามารถส่งรายงานจากเครือข่ายนี้ได้ในขณะนี้');
        if (!res.ok) throw new Error('ส่งไม่สำเร็จ กรุณาตรวจสอบข้อมูลแล้วลองใหม่');
      } else {
        document.getElementById('demo-note')!.hidden = false; // demo mode: nothing is sent
      }
      form.hidden = true;
      document.getElementById('success')!.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      showError(err instanceof Error ? err.message : 'เกิดข้อผิดพลาด กรุณาลองใหม่');
      submitBtn.disabled = false;
      submitBtn.textContent = 'ส่งรายงาน';
      (window as any).turnstile?.reset();
      tsToken = '';
    }
  });
</script>

<style is:global>
  .types { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .type { position: relative; }
  .type input { position: absolute; opacity: 0; inset: 0; }
  .type > span { display: flex; align-items: center; gap: 8px; min-height: 52px; padding: 8px 14px; border: 2px solid var(--border); border-radius: 12px; background: var(--surface); cursor: pointer; font-weight: 600; transition: border-color 0.15s, background 0.15s; }
  .type input:checked + span { border-color: var(--primary); background: var(--surface-2); }
  .type input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .type .ico { font-size: 1.3rem; }
  .loc-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .pick-map { position: relative; height: 340px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); margin-top: 8px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  #report-form { max-width: 720px; margin-top: 8px; }
  #success { max-width: 720px; }
</style>
