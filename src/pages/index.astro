---
import Base from '../layouts/Base.astro';
import MapView from '../components/MapView.astro';
import ReportList from '../components/ReportList.astro';
import TypeLegend from '../components/TypeLegend.astro';
import { reports, stats, generatedAt, isDemo } from '../lib/data';
import { thaiDate } from '../lib/format';
import { url } from '../lib/url';

const s = stats();
const faqs = [
  ['ต้องสมัครสมาชิกก่อนแจ้งเหตุหรือไม่?', 'ไม่ต้อง คุณสามารถแจ้งเหตุได้ทันที โดยระบุเพียงประเภทเหตุการณ์ ตำแหน่ง และเวลาที่พบ'],
  ['ทำไมรายงานจึงขึ้นสถานะ "ยังไม่ยืนยัน"?', 'รายงานทั้งหมดมาจากประชาชนและเผยแพร่ทันทีโดยไม่ผ่านการตรวจสอบก่อน จึงเป็นข้อมูลเฝ้าระวังเบื้องต้น ไม่ใช่ผลตรวจคุณภาพน้ำอย่างเป็นทางการ'],
  ['ข้อมูลของฉันถูกเก็บอะไรบ้าง?', 'เก็บข้อมูลที่คุณกรอก และที่อยู่ IP เพื่อป้องกันสแปม โดยไม่เปิดเผย IP ต่อสาธารณะ และลบอัตโนมัติตามระยะเวลาที่กำหนดในนโยบายความเป็นส่วนตัว'],
  ['แผนที่อัปเดตบ่อยแค่ไหน?', 'ข้อมูลบนเว็บอัปเดตอัตโนมัติทุกชั่วโมง'],
];
---
<Base
  title="แผนที่รายงานคุณภาพน้ำโดยประชาชน — แจ้งน้ำเสีย ปลาตาย น้ำเปลี่ยนสี"
  description="ดูรายงานคุณภาพน้ำผิดปกติทั่วประเทศไทยบนแผนที่ และแจ้งเหตุน้ำเสีย ปลาตาย น้ำเปลี่ยนสี ได้ทันทีโดยไม่ต้องสมัครสมาชิก"
  path="/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  }}
>
  <section class="hero">
    <div class="wrap">
      <h1>ช่วยกันเฝ้าระวัง<br />คุณภาพน้ำใกล้บ้านคุณ</h1>
      <p class="lead">พบน้ำเน่าเสีย ปลาตาย น้ำเปลี่ยนสี หรือคราบน้ำมัน? แจ้งได้ใน 1 นาที ไม่ต้องสมัครสมาชิก ไม่ต้องแนบรูป</p>
      <p><a class="btn big" href={url('/report/')}>📍 แจ้งเหตุตอนนี้</a> <a class="btn secondary big" href="#map">ดูแผนที่</a></p>
      {isDemo && <p class="notice demo">โหมดทดลอง: ข้อมูลบนหน้านี้เป็นข้อมูลสมมติเพื่อการพัฒนา</p>}
    </div>
  </section>

  <section class="wrap" aria-label="สถิติ">
    <div class="grid cols-4 stats">
      <div class="card"><div class="num">{s.last24h}</div><div class="muted">รายงานใน 24 ชั่วโมง</div></div>
      <div class="card"><div class="num">{s.last7d}</div><div class="muted">รายงานใน 7 วัน</div></div>
      <div class="card"><div class="num">{s.total}</div><div class="muted">รายงานใน 30 วัน</div></div>
      <div class="card"><div class="num">{s.provinces}</div><div class="muted">จังหวัดที่มีรายงาน</div></div>
    </div>
  </section>

  <section class="wrap section" id="map">
    <h2>แผนที่รายงานล่าสุด</h2>
    <MapView reports={reports} />
    <TypeLegend />
    <p class="muted small">อัปเดตล่าสุด {thaiDate(generatedAt)} · ทุกรายงาน "ยังไม่ยืนยัน"</p>
  </section>

  <section class="wrap section">
    <h2>รายงานล่าสุด</h2>
    <ReportList reports={reports} limit={10} />
    <p><a href={url('/province/')}>ดูรายงานแยกตามจังหวัด →</a></p>
  </section>

  <section class="wrap section">
    <h2>ใช้งานอย่างไร</h2>
    <ol class="grid cols-3 steps">
      <li class="card"><h3>1. เลือกประเภท</h3><p>ปลาตาย น้ำเปลี่ยนสี กลิ่นเหม็น คราบน้ำมัน ขยะ หรืออื่น ๆ</p></li>
      <li class="card"><h3>2. ระบุตำแหน่ง</h3><p>กดใช้ GPS หรือจิ้มบนแผนที่ ระบบจะเลือกจังหวัดให้</p></li>
      <li class="card"><h3>3. ส่งรายงาน</h3><p>เวลาเริ่มต้นเป็นเวลาปัจจุบัน แนบรายละเอียดหรือไม่ก็ได้</p></li>
    </ol>
  </section>

  <section class="wrap section">
    <h2>คำถามที่พบบ่อย</h2>
    <div class="faq">
      {faqs.map(([q, a]) => (
        <details class="card"><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { background: linear-gradient(135deg, #0a5c8f, #0e8f9c); color: #fff; padding-block: 56px 72px; margin-bottom: -40px; }
  .hero h1 { margin-bottom: 12px; }
  .hero .lead { font-size: 1.15rem; max-width: 52ch; opacity: 0.95; }
  .hero .btn { background: #fff; color: #0a5c8f; }
  .hero .btn:hover { background: #e6f7fb; color: #084a74; }
  .hero .btn.secondary { background: transparent; color: #fff; border-color: #fff; }
  .hero .btn.secondary:hover { background: rgb(255 255 255 / 0.15); color: #fff; }
  .btn.big { min-height: 54px; padding: 0 28px; font-size: 1.05rem; }
  .demo { margin-top: 12px; display: inline-block; }
  .stats { position: relative; }
  .num { font-size: 2.2rem; font-weight: 700; color: var(--primary); line-height: 1.2; }
  .steps { list-style: none; padding: 0; margin: 0; }
  .faq { display: grid; gap: 10px; max-width: 760px; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { margin: 10px 0 0; color: var(--muted); }
  .small { font-size: 0.88rem; }
</style>
