---
import Base from '../../layouts/Base.astro';
import { PROVINCES } from '../../lib/provinces';
import { reports } from '../../lib/data';
import { url } from '../../lib/url';

const counts = new Map<string, number>();
for (const r of reports) counts.set(r.province, (counts.get(r.province) ?? 0) + 1);
const rows = PROVINCES.map((p) => ({ ...p, n: counts.get(p.slug) ?? 0 })).sort((a, b) => b.n - a.n || a.name.localeCompare(b.name, 'th'));
---
<Base
  title="รายงานคุณภาพน้ำรายจังหวัด ทั้ง 77 จังหวัด"
  description="เลือกดูรายงานน้ำเสีย ปลาตาย น้ำเปลี่ยนสี แยกตามจังหวัดทั่วประเทศไทย อัปเดตทุกชั่วโมง"
  path="/province/"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: Astro.site ? new URL(url('/'), Astro.site).href : url('/') }, { '@type': 'ListItem', position: 2, name: 'รายจังหวัด' }] }}
>
  <div class="wrap section">
    <h1>รายงานคุณภาพน้ำรายจังหวัด</h1>
    <p class="muted">จำนวนรายงานในช่วง 30 วันที่ผ่านมา เรียงจากมากไปน้อย</p>
    <ul class="plist">
      {rows.map((p) => (
        <li><a class="card" href={url(`/province/${p.slug}/`)}><span>{p.name}</span><span class:list={['badge', p.n > 0 && 'warn']}>{p.n}</span></a></li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .plist { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .plist a { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; text-decoration: none; color: var(--text); font-weight: 600; }
  .plist a:hover { border-color: var(--primary); }
</style>
