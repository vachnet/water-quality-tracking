---
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE } from '../lib/types';
import { abs, url } from '../lib/url';
import { t, lpath, lurl, otherLang, OG_LOCALE, PCD_DATASET, type Lang } from '../lib/i18n';
import { tx } from '../lib/toxicI18n';

interface Props {
  title: string;
  description: string;
  /** Language-neutral path, e.g. '/province/bangkok/'. */
  path: string;
  lang?: Lang;
  noindex?: boolean;
  jsonLd?: object | object[];
  /** false for pages that exist in one language only (admin, 404). */
  alternates?: boolean;
  /** Hide the sticky mobile "Report" bar (the report page itself). */
  hideReportBar?: boolean;
  /** Atom feed (absolute URL) advertised with <link rel="alternate">. */
  feed?: { href: string; title: string };
}
const { title, description, path, lang = 'th', noindex = false, jsonLd, alternates = true, hideReportBar = false, feed } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
const canonical = abs(lpath(lang, path), Astro.site);
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ogImage = abs('/og-image.png', Astro.site);
const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    alternateName: SITE_TAGLINE[lang],
    url: abs(lpath(lang, '/'), Astro.site),
    inLanguage: lang === 'th' ? 'th-TH' : 'en',
  },
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
const nav = [
  { href: '/', label: d.nav.map },
  { href: '/toxic/', label: tx(lang).nav, alert: true },
  { href: '/province/', label: d.nav.provinces },
  { href: '/guide/', label: d.nav.guide },
  { href: '/about/', label: d.nav.about },
];
const here = Astro.url.pathname;
const isCurrent = (href: string) => {
  const u = lurl(lang, href);
  return href === '/' ? here === u : here.startsWith(u);
};
const switchHref = alternates ? lurl(other, path) : lurl(other, '/');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="th" href={abs(lpath('th', path), Astro.site)} />
        <link rel="alternate" hreflang="en" href={abs(lpath('en', path), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={abs(lpath('th', path), Astro.site)} />
      </>
    )}
    {feed && <link rel="alternate" type="application/atom+xml" title={feed.title} href={feed.href} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0a5c8f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1620" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {alternates && <meta property="og:locale:alternate" content={OG_LOCALE[other]} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_TAGLINE[lang]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(baseLd)} />
  </head>
  <body class:list={[!hideReportBar && 'has-bar']}>
    <a class="skip" href="#main">{d.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={lurl(lang, '/')} aria-label={`${SITE_NAME} — ${d.home}`}>
          <svg class="logo" width="34" height="34" viewBox="0 0 64 64" aria-hidden="true">
            <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0e8fb8" /><stop offset="1" stop-color="#0a4f7c" /></linearGradient></defs>
            <rect width="64" height="64" rx="16" fill="url(#lg)" />
            <path d="M32 11C32 11 17 28.5 17 38.5a15 15 0 0 0 30 0C47 28.5 32 11 32 11z" fill="#fff" />
            <path d="M22.5 40.5c3.2 2.6 6.3 2.6 9.5 0s6.3-2.6 9.5 0" fill="none" stroke="#0a5c8f" stroke-width="3.4" stroke-linecap="round" />
          </svg>
          <span class="brand-text"><span class="brand-name">{SITE_NAME}</span><span class="brand-tag">{SITE_TAGLINE[lang]}</span></span>
        </a>
        <nav aria-label={d.navLabel} class="main-nav">
          <ul>
            {nav.map((n) => (
              <li><a href={lurl(lang, n.href)} class:list={[n.alert && 'nav-alert']} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                {n.alert && <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.2 15.2 14H.8z" fill="currentColor" /><path d="M8 5.6v4.2M8 11.6v.4" stroke="var(--surface)" stroke-width="1.8" stroke-linecap="round" /></svg>}
                {n.label}
              </a></li>
            ))}
          </ul>
        </nav>
        <a class="lang-switch" href={switchHref} hreflang={other} lang={other} title={d.switchLabel}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" /></svg>
          <span>{d.switchTo}</span>
        </a>
        <a class="btn accent small header-cta" href={lurl(lang, '/report/')}>{d.reportCtaLong}</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <p class="brand-name">{SITE_NAME}</p>
          <p class="muted">{SITE_TAGLINE[lang]}</p>
          <p class="muted small">{d.footer.disclaimer}</p>
        </div>
        <div>
          <p class="foot-h">{d.footer.data}</p>
          <ul class="foot-list small">
            <li><a href={PCD_DATASET} target="_blank" rel="noopener noreferrer">{d.footer.pcd} ↗</a></li>
            <li><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">{d.footer.osm} ↗</a></li>
          </ul>
        </div>
        <div>
          <p class="foot-h">{SITE_NAME}</p>
          <ul class="foot-list small">
            <li><a href={lurl(lang, '/toxic/')}>{tx(lang).nav}</a></li>
            <li><a href={url(lang === 'en' ? '/en/toxic.xml' : '/toxic.xml')} type="application/atom+xml">{tx(lang).rssH} (Atom)</a></li>
            <li><a href={lurl(lang, '/about/')}>{d.footer.about}</a></li>
            <li><a href={lurl(lang, '/guide/')}>{d.footer.guide}</a></li>
            <li><a href={lurl(lang, '/privacy/')}>{d.footer.privacy}</a></li>
          </ul>
        </div>
        <div>
          <p class="foot-h">{d.footer.language}</p>
          <ul class="foot-list small">
            <li><a href={alternates ? lurl('th', path) : lurl('th', '/')} hreflang="th" lang="th" aria-current={lang === 'th' ? 'true' : undefined}>ไทย</a></li>
            <li><a href={alternates ? lurl('en', path) : lurl('en', '/')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a></li>
          </ul>
        </div>
      </div>
    </footer>
    {!hideReportBar && (
      <div class="action-bar">
        <a class="btn accent big block" href={lurl(lang, '/report/')}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><path d="M12 7v5M9.5 9.5h5" /></svg>
          {d.reportCtaLong}
        </a>
      </div>
    )}
    <script>
      // Keep relative times ("3 hours ago") fresh between hourly rebuilds.
      import { timeAgo } from '../lib/format';
      const lang = document.documentElement.lang === 'en' ? 'en' : 'th';
      const tick = () => document.querySelectorAll<HTMLTimeElement>('time[data-ago]').forEach((el) => (el.textContent = timeAgo(el.dateTime, lang)));
      tick();
      setInterval(tick, 60000);
    </script>
  </body>
</html>

<style is:global>
  .site-header { background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 30; }
  .site-header .bar { display: flex; align-items: center; gap: var(--sp-3); min-height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; margin-right: auto; min-width: 0; }
  .brand:hover { color: var(--text); }
  .logo { flex: none; border-radius: 10px; }
  .brand-text { display: grid; line-height: 1.15; min-width: 0; }
  .brand-name { font-weight: 700; font-size: 1.08rem; letter-spacing: -0.01em; }
  .brand-tag { font-size: var(--fs-xs); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .main-nav ul { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .main-nav a { display: flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: var(--r-pill); color: var(--text); text-decoration: none; font-weight: 600; font-size: var(--fs-sm); }
  .main-nav a:hover { background: var(--surface-2); color: var(--text); }
  .main-nav a[aria-current='page'] { background: var(--primary-soft); color: var(--primary); }
  .main-nav a.nav-alert { gap: 6px; color: var(--lvl-confirmed, #b42318); }
  .main-nav a.nav-alert[aria-current='page'] { background: var(--lvl-confirmed-bg, #fde8e6); color: var(--lvl-confirmed, #b42318); }
  .lang-switch { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: var(--r-pill); border: 1px solid var(--border); color: var(--text); text-decoration: none; font-weight: 600; font-size: var(--fs-sm); }
  .lang-switch:hover { background: var(--surface-2); color: var(--text); }
  @media (max-width: 860px) {
    .site-header .bar { flex-wrap: wrap; gap: 0 var(--sp-2); padding-top: 8px; }
    .brand-tag { display: none; }
    .header-cta { display: none; }
    .main-nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; margin: 0 -8px; width: calc(100% + 16px); }
    .main-nav ul { padding: 4px 8px 8px; }
    .main-nav a { white-space: nowrap; padding: 0 12px; }
  }

  .site-footer { border-top: 1px solid var(--border); background: var(--surface); padding-block: var(--sp-6); margin-top: var(--sp-7); }
  .foot { display: grid; gap: var(--sp-5); grid-template-columns: 1.4fr 1.4fr 1fr 0.8fr; }
  .foot p { margin: 0 0 6px; }
  .foot-h { font-weight: 700; font-size: var(--fs-sm); }
  .foot-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
  .foot-list a { display: inline-flex; align-items: center; min-height: 36px; color: var(--muted); }
  .foot-list a:hover, .foot-list a[aria-current] { color: var(--primary); }
  .foot-list a[aria-current] { font-weight: 700; }
  @media (max-width: 860px) { .foot { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }

  .action-bar { display: none; }
  @media (max-width: 860px) {
    .action-bar { display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid var(--border); }
    body.has-bar { padding-bottom: calc(80px + env(safe-area-inset-bottom)); }
  }
</style>
