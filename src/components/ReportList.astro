---
import { typeById, SOURCE_LABEL, type Report } from '../lib/types';
import { provinceBySlug } from '../lib/provinces';
import { thaiDate, timeAgo } from '../lib/format';
interface Props { reports: Report[]; limit?: number; showProvince?: boolean }
const { reports, limit = 12, showProvince = true } = Astro.props;
const items = reports.slice(0, limit);
---
{items.length === 0 ? (
  <p class="muted">ยังไม่มีรายงานในช่วง 30 วันที่ผ่านมา</p>
) : (
  <ul class="report-list">
    {items.map((r) => {
      const t = typeById(r.type);
      return (
        <li class="card">
          <div class="row">
            <span class="dot" style={`background:${t.color}`} aria-hidden="true"></span>
            <strong>{r.title ?? `${t.icon} ${t.label}`}</strong>
            <span class:list={['badge', 'src', r.source]}>{SOURCE_LABEL[r.source ?? 'community'].badge}</span>
            {r.status === 'flagged' && <span class="badge warn">รอตรวจสอบ</span>}
            {r.source === 'community' && <span class="badge">ยังไม่ยืนยัน</span>}
          </div>
          {r.description && <p>{r.description}</p>}
          {r.references && r.references.length > 0 && (
            <ul class="refs">
              {r.references.map((ref) => (
                <li><a href={ref.url} target="_blank" rel="noopener noreferrer">↗ {ref.name}</a></li>
              ))}
            </ul>
          )}
          <p class="meta muted">
            {showProvince && <>{provinceBySlug(r.province)?.name ?? '—'} · </>}
            <time datetime={r.occurredAt} title={thaiDate(r.occurredAt)}>{timeAgo(r.occurredAt)}</time>
          </p>
        </li>
      );
    })}
  </ul>
)}
<style>
  .report-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .report-list .card { padding: 14px 18px; }
  .row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  
  .report-list p { margin: 6px 0 0; }
  .meta { font-size: 0.88rem; }
  .refs { list-style: none; padding: 0; margin: 8px 0 0; font-size: 0.9rem; }
  .badge.src.government { background: color-mix(in srgb, var(--primary) 18%, var(--surface)); }
  .badge.src.news { background: color-mix(in srgb, var(--accent) 18%, var(--surface)); }
</style>
