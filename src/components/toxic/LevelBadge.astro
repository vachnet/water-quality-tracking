---
import type { Level } from '../../lib/toxic';
import { tx } from '../../lib/toxicI18n';
import type { Lang } from '../../lib/i18n';
interface Props { level: Level; lang: Lang; size?: 'sm' | 'md' }
const { level, lang, size = 'sm' } = Astro.props;
---
<span class:list={['lvl', `lvl-${level}`, size]}>
  <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
    {level === 'confirmed' && <><path d="M8 1.2 15.2 14H.8z" fill="currentColor" /><path d="M8 5.6v4.2M8 11.6v.4" stroke="var(--lvl-ink)" stroke-width="1.8" stroke-linecap="round" /></>}
    {level === 'watch' && <><circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 2" /><circle cx="8" cy="8" r="2.4" fill="currentColor" /></>}
    {level === 'ok' && <path d="m3 8.5 3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />}
  </svg>
  {tx(lang).level[level]}
</span>
<style is:global>
  .lvl { --lvl-ink: var(--surface); display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-xs); font-weight: 700; line-height: 1.4; padding: 3px 10px; border-radius: var(--r-pill); white-space: nowrap; border: 1.5px solid currentColor; }
  .lvl.md { font-size: var(--fs-sm); padding: 4px 12px; }
  .lvl-confirmed { color: var(--lvl-confirmed); background: var(--lvl-confirmed-bg); --lvl-ink: var(--lvl-confirmed-bg); }
  .lvl-watch { color: var(--lvl-watch); background: var(--lvl-watch-bg); border-style: dashed; }
  .lvl-ok { color: var(--lvl-ok); background: var(--lvl-ok-bg); border-style: dotted; }
</style>
