---
import SourceIcon from './SourceIcon.astro';
import { t, type Lang } from '../lib/i18n';
import { timeAgo } from '../lib/format';
import type { ReportView } from '../lib/data';
interface Props { r: ReportView; lang: Lang; showProvince?: boolean; mapLink?: boolean }
const { r, lang, showProvince = true, mapLink = true } = Astro.props;
const d = t(lang);
---
<li class:list={['rcard', `src-${r.source}`]} data-id={r.id} data-source={r.source}>
  <div class="rc-top">
    <span class="badge src"><SourceIcon source={r.source} size={12} />{d.source[r.source]}</span>
    {r.unverified && <span class="badge warn">{d.unverified}</span>}
    {r.flagged && <span class="badge warn">{d.flagged}</span>}
    <span class="rc-when muted">
      {r.source === 'community'
        ? <time datetime={r.at} title={r.whenTitle} data-ago>{timeAgo(r.at, lang)}</time>
        : <time datetime={r.at} title={r.whenTitle}>{r.when}</time>}
    </span>
  </div>
  <h3 class="rc-title">
    {mapLink
      ? <button type="button" class="rc-focus" data-focus={r.id}><span lang={r.titleLang}>{r.title}</span><span class="sr-only"> — {d.showOnMap}</span></button>
      : <span lang={r.titleLang}>{r.title}</span>}
    {r.titleLang === 'th' && lang === 'en' && <span class="badge lang-tag">{d.inThai}</span>}
  </h3>
  <p class="rc-meta muted">
    <span aria-hidden="true">{r.icon}</span> {r.typeLabel}{showProvince && <> · {r.provinceName}</>}
    {r.precision !== 'exact' && <> · <span class="rc-approx">{r.precision === 'province' ? d.provinceLevel : d.approximate}</span></>}
  </p>
  {r.metrics && <p class="rc-metric">{r.metrics}</p>}
  {r.description && <p class="rc-desc" lang={r.descLang}>{r.description}</p>}
  {r.refs.length > 0 && (
    <ul class="rc-refs">
      {r.refs.map((ref) => (
        <li><a href={ref.url} target="_blank" rel="noopener noreferrer"><span class="rc-refp">{d.sourcePrefix}</span> {ref.name} <span aria-hidden="true">↗</span><span class="sr-only"> {d.newTab}</span></a></li>
      ))}
    </ul>
  )}
</li>
<style is:global>
  .rcard { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-lg); padding: var(--sp-4) var(--sp-4) var(--sp-4) calc(var(--sp-4) + 4px); box-shadow: var(--e-1); transition: border-color 0.15s, box-shadow 0.2s, transform 0.2s var(--ease); }
  .rcard::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 4px; border-radius: 0 4px 4px 0; background: var(--c); }
  .rcard.is-active { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 25%, transparent), var(--e-2); }
  .rc-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 6px; }
  .rc-when { margin-left: auto; font-size: var(--fs-xs); }
  .rc-title { font-size: 1.02rem; line-height: 1.45; margin: 0 0 2px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
  .rc-focus { all: unset; cursor: pointer; border-radius: 4px; color: var(--text); }
  .rc-focus:hover { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
  .rc-focus:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .lang-tag { font-weight: 500; }
  .rc-meta { font-size: var(--fs-sm); margin: 0; }
  .rc-approx { font-style: italic; }
  .rc-metric { display: inline-block; margin: 8px 0 0; font-size: var(--fs-sm); font-weight: 600; padding: 2px 10px; border-radius: var(--r-sm); background: var(--surface-2); }
  .rc-desc { margin: 8px 0 0; font-size: var(--fs-sm); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .rc-refs { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 2px; font-size: var(--fs-sm); }
  .rc-refs a { display: inline-block; padding: 4px 0; font-weight: 600; overflow-wrap: anywhere; }
  .rc-refp { color: var(--muted); font-weight: 500; }
</style>
