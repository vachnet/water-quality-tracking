---
import type { Report } from '../lib/types';
interface Props {
  reports: Report[];
  center?: [number, number];
  zoom?: number;
  height?: string;
  label?: string;
}
const { reports, center, zoom, height = '520px', label = 'แผนที่รายงานคุณภาพน้ำ' } = Astro.props;
---
<div class="map-shell" style={`--h:${height}`} data-center={center ? JSON.stringify(center) : undefined} data-zoom={zoom}>
  <div class="map-canvas" role="region" aria-label={label}></div>
  <div class="map-placeholder">
    <p>กำลังโหลดแผนที่…</p>
    <noscript>เปิด JavaScript เพื่อดูแผนที่ หรือดูรายการรายงานด้านล่าง</noscript>
  </div>
  <script type="application/json" class="map-data" set:html={JSON.stringify(reports)} />
</div>

<script>
  import { createMap } from '../lib/map';
  document.querySelectorAll<HTMLElement>('.map-shell').forEach((shell) => {
    const canvas = shell.querySelector<HTMLElement>('.map-canvas')!;
    const reports = JSON.parse(shell.querySelector('.map-data')!.textContent || '[]');
    const start = () => {
      createMap(canvas, {
        reports,
        center: shell.dataset.center ? JSON.parse(shell.dataset.center) : undefined,
        zoom: shell.dataset.zoom ? Number(shell.dataset.zoom) : undefined,
      }).then(() => shell.classList.add('ready'))
        .catch(() => {
          const p = shell.querySelector('.map-placeholder p');
          if (p) p.textContent = 'ไม่สามารถแสดงแผนที่ได้ (เบราว์เซอร์อาจปิด WebGL) — ดูรายการรายงานด้านล่างแทน';
        });
    };
    // Load only when scrolled near, and only once the browser is idle (keeps LCP/INP clean).
    const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb) : setTimeout(cb, 200));
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        obs.disconnect();
        idle(start);
      }
    }, { rootMargin: '200px' }).observe(shell);
  });
</script>

<style is:global>
  .map-shell { position: relative; height: var(--h); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); background: var(--surface-2); }
  /* maplibre-gl.css sets .maplibregl-map { position: relative }, which collapses this to 0 height; win on specificity */
  .map-shell .map-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map-placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); pointer-events: none; }
  .map-shell.ready .map-placeholder { display: none; }
  .map-note { position: absolute; left: 12px; right: 56px; bottom: 28px; z-index: 5; padding: 10px 14px; border-radius: 10px; background: var(--warn-bg); color: var(--warn-text); font-size: 0.92rem; }
  .locate-btn { display: grid; place-items: center; }
  .me-dot { width: 18px; height: 18px; border-radius: 50%; background: #1a73e8; border: 3px solid #fff; box-shadow: 0 0 0 6px rgb(26 115 232 / 0.25); }
  .map-popup strong { display: block; margin-bottom: 2px; color: #0f2a3a; }
  .map-popup .when { font-size: 0.82rem; color: #4b6475; }
  .map-popup p { margin: 6px 0 4px; color: #0f2a3a; }
  .map-popup small { color: #6b4a00; }
  .maplibregl-popup-content { font-family: var(--font); border-radius: 10px; }
</style>
