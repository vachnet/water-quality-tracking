---
import Base from '../../layouts/Base.astro';
import { REPORT_TYPES } from '../../lib/types';
import { PROVINCES } from '../../lib/provinces';
import { t, lurl, type Lang } from '../../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const r = d.report;
const provinces = [...PROVINCES].sort((a, b) => (lang === 'en' ? a.nameEn.localeCompare(b.nameEn, 'en') : a.name.localeCompare(b.name, 'th')));
const provinceNames = Object.fromEntries(PROVINCES.map((p) => [p.slug, lang === 'en' ? p.nameEn : p.name]));
// Strings for the client script (no data-derived content).
const msgs = {
  progress: r.progress(-1).replace('-1', '{n}'),
  gps: r.gps, gpsLocating: r.gpsLocating, gpsOk: r.gpsOk, gpsRetry: r.gpsRetry,
  pick: r.pick, pickHide: r.pickHide,
  locNone: r.locNone, locGps: r.locGps, locPicked: r.locPicked,
  accuracy: r.accuracy(-1).replace('-1', '{n}'),
  noGps: r.noGps, gpsDenied: r.gpsDenied, gpsFail: r.gpsFail,
  provinceSuggested: r.provinceSuggested('{p}'),
  submit: r.submit, sending: r.sending,
  errType: r.errType, errLoc: r.errLoc, errProvince: r.errProvince, errTime: r.errTime, errBot: r.errBot, errSummary: r.errSummary,
  err429: r.err429, err403: r.err403, errGeneric: r.errGeneric, errNetwork: r.errNetwork,
  mapFailed: d.map.failed,
  provinces: provinceNames,
};
const MAX = 300;
---
<Base lang={lang} title={r.title} description={r.description} path="/report/" hideReportBar>
  <div class="wrap section report-wrap">
    <header class="r-head">
      <h1>{r.h1}</h1>
      <p class="muted">{r.intro}</p>
    </header>

    <div class="progress" aria-hidden="true"><span class="progress-bar"></span></div>
    <p class="sr-only" id="progress-text" aria-live="polite"></p>

    <form id="report-form" novalidate data-msgs={JSON.stringify(msgs)} data-lang={lang}>
      <!-- STEP 1 -->
      <fieldset class="step card" id="step-1" aria-describedby="err-type">
        <legend class="step-h"><span class="step-n" aria-hidden="true">1</span><span><span class="sr-only">{r.step(1)}: </span>{r.s1}</span></legend>
        <div class="types">
          {REPORT_TYPES.map((ty) => (
            <label class="type">
              <input type="radio" name="type" value={ty.id} required />
              <span class="type-box"><span class="ico" aria-hidden="true">{ty.icon}</span><span>{lang === 'en' ? ty.labelEn : ty.label}</span></span>
            </label>
          ))}
        </div>
        <p class="field-error" id="err-type" aria-live="polite"></p>
      </fieldset>

      <!-- STEP 2 -->
      <fieldset class="step card" id="step-2" aria-describedby="err-loc">
        <legend class="step-h"><span class="step-n" aria-hidden="true">2</span><span><span class="sr-only">{r.step(2)}: </span>{r.s2}</span></legend>
        <div class="loc-actions">
          <button type="button" class="btn big gps-btn" id="loc-btn" data-state="idle">
            <svg class="gps-ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><circle cx="12" cy="12" r="8" /><path d="M12 1v3M12 20v3M1 12h3M20 12h3" /></svg>
            <span class="gps-label">{r.gps}</span>
          </button>
          <button type="button" class="btn secondary big" id="pick-btn" aria-expanded="false" aria-controls="pick-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14" /></svg>
            <span class="pick-label">{r.pick}</span>
          </button>
        </div>
        <p class="hint small muted" id="gps-hint">{r.gpsHint}</p>
        <div id="pick-wrap" hidden>
          <p class="hint small muted">{r.pickHint}</p>
          <div id="pick-map" class="pick-map skeleton"></div>
        </div>
        <p class="loc-status" id="loc-status" aria-live="polite"><span class="loc-dot" aria-hidden="true"></span><span class="loc-text">{r.locNone}</span></p>
        <input type="hidden" name="lat" />
        <input type="hidden" name="lng" />
        <p class="field-error" id="err-loc" aria-live="polite"></p>

        <div class="field prov-field">
          <label for="province">{r.province}</label>
          <select id="province" name="province" required aria-describedby="province-hint err-province">
            <option value="">{r.provinceChoose}</option>
            {provinces.map((p) => <option value={p.slug}>{lang === 'en' ? p.nameEn : p.name}</option>)}
          </select>
          <span class="hint" id="province-hint">{r.provinceHint}</span>
          <p class="field-error" id="err-province" aria-live="polite"></p>
        </div>
      </fieldset>

      <!-- STEP 3 -->
      <fieldset class="step card" id="step-3">
        <legend class="step-h"><span class="step-n" aria-hidden="true">3</span><span><span class="sr-only">{r.step(3)}: </span>{r.s3}</span></legend>

        <details class="more-details" id="more-details">
          <summary><span>{r.whenShort}: <strong id="when-summary">{r.now}</strong> · {r.details} ({r.optional})</span></summary>
          <div class="field">
            <label for="occurredAt">{r.when}</label>
            <div class="when-row">
              <input id="occurredAt" name="occurredAt" type="datetime-local" required aria-describedby="when-hint err-time" />
              <button type="button" class="btn secondary" id="now-btn">{r.now}</button>
            </div>
            <span class="hint" id="when-hint">{r.whenHint}</span>
            <p class="field-error" id="err-time" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="description">{r.details} <span class="muted">({r.optional})</span></label>
            <textarea id="description" name="description" maxlength={MAX} placeholder={r.detailsPh} aria-describedby="desc-hint desc-count"></textarea>
            <div class="desc-foot"><span class="hint" id="desc-hint">{r.detailsHint}</span><span class="hint" id="desc-count">0/{MAX}</span></div>
          </div>
        </details>

        <!-- honeypot: humans never see this -->
        <div class="hp" aria-hidden="true"><label>{r.honeypot} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

        <div id="turnstile"></div>
        <p class="field-error" id="err-bot" aria-live="polite"></p>

        <p class="notice info privacy-note">{r.notice} <a href={lurl(lang, '/privacy/')}>{r.noticeLink}</a></p>

        <div id="form-msg" role="alert"></div>
        <button class="btn accent big block" type="submit" id="submit-btn">{r.submit}</button>
      </fieldset>
    </form>

    <section id="success" class="card success" hidden aria-labelledby="success-h">
      <div class="success-ico" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
      </div>
      <h2 id="success-h" tabindex="-1">{r.successH}</h2>
      <p>{r.successP}</p>
      <p id="demo-note" class="notice" hidden>{r.demoNote}</p>
      <h3>{r.next}</h3>
      <ol class="next">
        <li>{r.next1}</li>
        <li>{r.next2}</li>
        <li>{r.next3}</li>
      </ol>
      <div class="success-actions">
        <a class="btn big" href={lurl(lang, '/')}>{r.backMap}</a>
        <a class="btn secondary big" href={lurl(lang, '/report/')}>{r.another}</a>
        <a class="btn ghost" href={lurl(lang, '/guide/')}>{r.readGuide}</a>
      </div>
    </section>
  </div>
</Base>

<script>
  import { nearestProvince } from '../../lib/provinces';
  import { createMap, type MapHandle } from '../../lib/map';

  const API = import.meta.env.PUBLIC_REPORT_API_URL as string | undefined;
  const TS_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

  const form = document.getElementById('report-form') as HTMLFormElement;
  const M = JSON.parse(form.dataset.msgs || '{}') as Record<string, string> & { provinces: Record<string, string> };
  const lang = form.dataset.lang === 'en' ? 'en' : 'th';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const msg = $('form-msg');
  const submitBtn = $<HTMLButtonElement>('submit-btn');
  const provinceSel = $<HTMLSelectElement>('province');
  const when = $<HTMLInputElement>('occurredAt');
  const desc = $<HTMLTextAreaElement>('description');
  const gpsBtn = $<HTMLButtonElement>('loc-btn');
  const gpsLabel = gpsBtn.querySelector('.gps-label')!;
  const locStatus = $('loc-status');
  const locText = locStatus.querySelector('.loc-text')!;

  const setErr = (id: string, text: string, input?: HTMLElement | null) => {
    $(id).textContent = text;
    input?.setAttribute('aria-invalid', text ? 'true' : 'false');
    // Drop the summary once every inline error is resolved.
    if (!text && ![...form.querySelectorAll('.field-error')].some((e) => e.textContent)) msg.replaceChildren();
  };

  // ---- progress ----
  const done = () => [
    !!form.querySelector('input[name=type]:checked'),
    !!f('lat').value && !!provinceSel.value,
    false,
  ];
  const progress = () => {
    const d = done();
    const n = d.filter(Boolean).length;
    (document.querySelector('.progress-bar') as HTMLElement).style.width = `${Math.max(6, (n / 3) * 100)}%`;
    $('progress-text').textContent = M.progress.replace('{n}', String(n));
    d.forEach((ok, i) => $(`step-${i + 1}`).classList.toggle('done', ok));
  };

  // ---- time (default now, never in the future) ----
  const localNow = () => {
    const d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    return d.toISOString().slice(0, 16);
  };
  const setNow = () => { when.value = localNow(); when.max = localNow(); $('when-summary').textContent = $('now-btn').textContent; };
  setNow();
  $('now-btn').addEventListener('click', setNow);
  when.addEventListener('change', () => {
    const at = new Date(when.value);
    $('when-summary').textContent = isNaN(+at) ? '—' : at.toLocaleString(lang === 'th' ? 'th-TH' : 'en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    setErr('err-time', '', when);
  });
  desc.addEventListener('input', () => ($('desc-count').textContent = `${desc.value.length}/${desc.maxLength}`));

  // ---- step 1 ----
  form.querySelectorAll<HTMLInputElement>('input[name=type]').forEach((i) =>
    i.addEventListener('change', () => {
      setErr('err-type', '');
      progress();
      // Move straight on to "where" so a phone user needs no extra scrolling.
      if (!f('lat').value && i.matches(':focus-visible') === false) {
        $('step-2').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      }
    }),
  );

  // ---- step 2: location ----
  function setLocation(lat: number, lng: number, label: string, extra = '') {
    f('lat').value = lat.toFixed(5);
    f('lng').value = lng.toFixed(5);
    if (!provinceSel.value || provinceSel.dataset.auto === '1') {
      const p = nearestProvince(lat, lng);
      provinceSel.value = p.slug;
      provinceSel.dataset.auto = '1';
      $('province-hint').textContent = M.provinceSuggested.replace('{p}', M.provinces[p.slug] ?? p.slug);
      setErr('err-province', '', provinceSel);
    }
    locStatus.dataset.state = 'ok';
    locText.textContent = `${label}: ${lat.toFixed(4)}, ${lng.toFixed(4)}${extra ? ` (${extra})` : ''}`;
    setErr('err-loc', '');
    progress();
  }
  provinceSel.addEventListener('change', () => { provinceSel.dataset.auto = '0'; setErr('err-province', '', provinceSel); progress(); });

  const gpsState = (state: 'idle' | 'busy' | 'ok' | 'error', label: string) => {
    gpsBtn.dataset.state = state;
    gpsBtn.setAttribute('aria-busy', String(state === 'busy'));
    gpsBtn.disabled = state === 'busy';
    gpsLabel.textContent = label;
  };
  gpsBtn.addEventListener('click', () => {
    if (!navigator.geolocation) { gpsState('error', M.gps); setErr('err-loc', M.noGps); return; }
    gpsState('busy', M.gpsLocating);
    navigator.geolocation.getCurrentPosition(
      (p) => {
        const { latitude: lat, longitude: lng, accuracy } = p.coords;
        gpsState('ok', M.gpsOk);
        setLocation(lat, lng, M.locGps, accuracy ? M.accuracy.replace('{n}', String(Math.round(accuracy))) : '');
        silent = true; pick?.pick(lng, lat); silent = false;
        pick?.map.flyTo({ center: [lng, lat], zoom: 15 });
      },
      (err) => { gpsState('error', M.gpsRetry); setErr('err-loc', err.code === 1 ? M.gpsDenied : M.gpsFail); },
      { enableHighAccuracy: true, timeout: 12000 },
    );
  });

  let pick: MapHandle | undefined;
  let silent = false;
  const pickBtn = $<HTMLButtonElement>('pick-btn');
  pickBtn.addEventListener('click', async () => {
    const wrap = $('pick-wrap');
    const open = wrap.hidden;
    wrap.hidden = !open;
    pickBtn.setAttribute('aria-expanded', String(open));
    pickBtn.querySelector('.pick-label')!.textContent = open ? M.pickHide : M.pick;
    if (!open || pick) return;
    const el = $('pick-map');
    const hasLoc = !!f('lat').value;
    try {
      pick = await createMap(el, {
        center: hasLoc ? [Number(f('lng').value), Number(f('lat').value)] : undefined,
        zoom: hasLoc ? 14 : undefined,
        onPick: (lng, lat) => { if (!silent) setLocation(lat, lng, M.locPicked); },
      });
      pick.map.once('load', () => el.classList.remove('skeleton'));
      if (hasLoc) { silent = true; pick.pick(Number(f('lng').value), Number(f('lat').value)); silent = false; }
    } catch {
      el.classList.remove('skeleton');
      el.textContent = M.mapFailed;
    }
  });

  // ---- Turnstile (optional until a site key is configured) ----
  let tsToken = '';
  if (TS_KEY) {
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    s.async = true;
    s.onload = () =>
      (window as any).turnstile.render('#turnstile', {
        sitekey: TS_KEY,
        language: lang,
        callback: (tk: string) => { tsToken = tk; setErr('err-bot', ''); },
        'expired-callback': () => (tsToken = ''),
      });
    document.head.append(s);
  }

  const showError = (text: string) => {
    msg.replaceChildren();
    const p = document.createElement('p');
    p.className = 'notice err';
    p.textContent = text;
    msg.append(p);
  };

  function validate(): HTMLElement | null {
    let first: HTMLElement | null = null;
    const fail = (id: string, text: string, focusEl: HTMLElement, input?: HTMLElement) => { setErr(id, text, input); first ??= focusEl; };
    const type = form.querySelector('input[name=type]:checked');
    if (!type) fail('err-type', M.errType, form.querySelector('input[name=type]') as HTMLElement); else setErr('err-type', '');
    if (!f('lat').value) fail('err-loc', M.errLoc, gpsBtn); else setErr('err-loc', '');
    if (!provinceSel.value) fail('err-province', M.errProvince, provinceSel, provinceSel); else setErr('err-province', '', provinceSel);
    const at = new Date(when.value);
    if (isNaN(+at) || +at > Date.now() + 60000) {
      ($('more-details') as HTMLDetailsElement).open = true;
      fail('err-time', M.errTime, when, when);
    } else setErr('err-time', '', when);
    if (TS_KEY && !tsToken) fail('err-bot', M.errBot, $('turnstile')); else setErr('err-bot', '');
    return first;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.replaceChildren();
    const bad = validate();
    if (bad) {
      showError(M.errSummary);
      bad.focus();
      return;
    }
    const type = (form.querySelector('input[name=type]:checked') as HTMLInputElement).value;
    // API contract: unchanged field set.
    const body = {
      type,
      lat: Number(f('lat').value),
      lng: Number(f('lng').value),
      province: provinceSel.value,
      occurredAt: new Date(when.value).toISOString(),
      description: (desc.value || '').trim() || undefined,
      website: f('website').value, // honeypot
      turnstileToken: tsToken || undefined,
    };

    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    submitBtn.textContent = M.sending;
    try {
      if (API) {
        let res: Response;
        try {
          res = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        } catch {
          throw new Error(M.errNetwork);
        }
        if (res.status === 429) throw new Error(M.err429);
        if (res.status === 403) throw new Error(M.err403);
        if (!res.ok) throw new Error(M.errGeneric);
      } else {
        $('demo-note').hidden = false; // demo mode: nothing is sent
      }
      form.hidden = true;
      document.querySelector<HTMLElement>('.progress')!.hidden = true;
      $('success').hidden = false;
      window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      $('success-h').focus({ preventScroll: true });
    } catch (err) {
      showError(err instanceof Error ? err.message : M.errGeneric);
      submitBtn.disabled = false;
      submitBtn.removeAttribute('aria-busy');
      submitBtn.textContent = M.submit;
      (window as any).turnstile?.reset();
      tsToken = '';
    }
  });

  progress();
</script>

<style is:global>
  .report-wrap { max-width: 760px; }
  .r-head h1 { margin-bottom: var(--sp-1); }
  .progress { position: sticky; top: var(--header-h); z-index: 5; height: 6px; border-radius: var(--r-pill); background: var(--surface-3); margin: var(--sp-4) 0 var(--sp-5); overflow: hidden; }
  .progress-bar { display: block; height: 100%; width: 6%; border-radius: inherit; background: linear-gradient(90deg, var(--primary), var(--accent)); transition: width 0.4s var(--ease); }
  .step { border: 1px solid var(--border); margin: 0 0 var(--sp-4); padding: var(--sp-5); min-width: 0; }
  .step-h { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--fs-lg); font-weight: 700; padding: 0; margin-bottom: var(--sp-4); float: left; width: 100%; }
  .step-h + * { clear: both; }
  .step .step-n { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--surface-2); color: var(--primary); font-size: var(--fs-md); flex: none; transition: background 0.2s; }
  .step.done .step-n { background: var(--ok); color: var(--surface); font-size: 0; }
  .step.done .step-n::after { content: '✓'; font-size: 1rem; }
  .types { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--sp-2); }
  .type { position: relative; }
  .type input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .type-box { display: flex; align-items: center; gap: 10px; min-height: 60px; padding: 8px 14px; border: 2px solid var(--border); border-radius: var(--r-md); background: var(--surface); font-weight: 600; line-height: 1.3; transition: border-color 0.15s, background 0.15s, transform 0.1s; }
  .type:hover .type-box { border-color: color-mix(in srgb, var(--primary) 50%, var(--border)); }
  .type input:checked + .type-box { border-color: var(--primary); background: var(--primary-soft); box-shadow: inset 0 0 0 1px var(--primary); }
  .type input:focus-visible + .type-box { outline: 3px solid var(--focus); outline-offset: 2px; }
  .type .ico { font-size: 1.5rem; }
  .loc-actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2); }
  .loc-actions .btn { padding: 0 16px; }
  .gps-btn[data-state='busy'] .gps-ico { animation: spin 1.1s linear infinite; }
  .gps-btn[data-state='ok'] { background: var(--ok); color: var(--surface); }
  .gps-btn[data-state='error'] { background: var(--surface); color: var(--danger); border-color: var(--danger); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hint { margin: 8px 0 0; }
  .pick-map { position: relative; height: 340px; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--border); margin-top: 8px; display: grid; place-items: center; color: var(--muted); }
  .loc-status { display: flex; align-items: center; gap: 8px; margin: var(--sp-3) 0 0; padding: 10px 14px; border-radius: var(--r-md); background: var(--surface-2); font-size: var(--fs-sm); font-weight: 600; }
  .loc-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--muted); flex: none; }
  .loc-status[data-state='ok'] { background: color-mix(in srgb, var(--ok) 14%, var(--surface)); color: var(--ok); }
  .loc-status[data-state='ok'] .loc-dot { background: var(--ok); }
  .prov-field { margin: var(--sp-4) 0 0; }
  .more-details { border: 1px solid var(--border); border-radius: var(--r-md); margin-bottom: var(--sp-4); }
  .more-details summary { cursor: pointer; padding: 12px 16px; min-height: var(--tap); display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); font-size: var(--fs-sm); list-style: none; }
  .more-details summary::-webkit-details-marker { display: none; }
  .more-details summary::after { content: '+'; font-size: 1.3rem; line-height: 1; color: var(--primary); transition: transform 0.2s; }
  .more-details[open] summary::after { transform: rotate(45deg); }
  .more-details[open] summary { border-bottom: 1px solid var(--border); margin-bottom: var(--sp-4); }
  .more-details .field { padding: 0 16px; }
  .when-row { display: flex; gap: var(--sp-2); }
  .when-row input { flex: 1; min-width: 0; }
  .desc-foot { display: flex; justify-content: space-between; gap: var(--sp-3); }
  .desc-foot .hint { margin: 0; }
  .privacy-note { margin: var(--sp-4) 0; }
  #form-msg:not(:empty) { margin-bottom: var(--sp-3); }
  #turnstile:not(:empty) { margin-bottom: var(--sp-3); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .success { text-align: center; animation: rise 0.4s var(--ease) both; }
  .success-ico { display: grid; place-items: center; width: 72px; height: 72px; margin: 0 auto var(--sp-3); border-radius: 50%; background: color-mix(in srgb, var(--ok) 16%, var(--surface)); color: var(--ok); }
  .success h2:focus { outline: none; }
  .success .next { text-align: left; max-width: 52ch; margin: 0 auto var(--sp-5); padding-left: 1.3em; }
